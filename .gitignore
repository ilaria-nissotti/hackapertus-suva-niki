# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.suva-work/

# Node
node_modules/
dist/
build/
# Playwright run output (the screenshot baselines in e2e/*-snapshots/ are committed)
test-results/
playwright-report/

# OS and editor
.DS_Store
.idea/
.vscode/

# Runtime state (KB, LLM cache) — snapshot policy decided in the eval/demo step
data/*.sqlite
data/*.sqlite-*
.pytest_cache/
*.egg-info/
# Downloaded source data (OpenCaseLaw parquet, entscheidsuche HTML)
data/raw/
# Scoring outputs (dataset, feature stats, scores, judge verdicts) — regenerated from the KB
data/scoring/
# Generated by the pipeline or the app; never commit without approval (see AGENTS.md)
data/split-manifest.json
data/*-locks/
# Suggested weights from `fit-weights`: reviewed by experts, then copied into rules.yaml
rules/rules.fitted.yaml

# Logs, coverage and tool caches
*.log
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.tsbuildinfo

# Review app: key of the session cookie that holds who is reviewing (src/app.py), and the browser tests' reviewer
data/session-secret
src/frontend/playwright/.auth/
