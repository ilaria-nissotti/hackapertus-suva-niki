# Copy to .env and fill in. Never commit .env.
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=
LLM_API_KEY=

# Where runtime state lives (KB, LLM cache). Relative to the repo root.
DATA_DIR=data
# Knowledge base. sqlite:///<path> today; the repository interface allows Postgres later.
DATABASE_URL=sqlite:///data/kb.sqlite
# readwrite (default) | readonly (frozen snapshot / offline demo: cache miss = error) | off
LLM_CACHE_MODE=readwrite
# Seconds per request and retry count for the gateway
LLM_TIMEOUT=120
LLM_MAX_RETRIES=5
# Log level for `python -m suva` and `src/app.py` (stderr): DEBUG | INFO (default) | WARNING | ERROR
LOG_LEVEL=INFO

# ElevenLabs (optional): audio briefings of approved summaries and voice questions.
# The key needs Text to Speech (narration) and Speech to Text (microphone questions).
# Voice IDs: letters, digits, _ and - only. Leave empty to disable audio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DE=
ELEVENLABS_VOICE_ID_FR=
